CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=""

# ========== 内存优化 ==========
# 改用 256M 内存配置（更保守，适合亚瑟）
CONFIG_ATH11K_MEM_PROFILE_256M=y
# NSS 固件版本降到最低（稳定优先）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ========== 基础 LuCI（必须） ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-firewall=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ========== 你需要的驱动（全在这里） ==========
# 1. MT7612U 无线网卡驱动
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_mt76-firmware=y

# 2. 手机 USB 共享（RNDIS / CDC 协议）
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# 3. USB 内核基础支持
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y

# 4. 轻 NAS（仅 SMB 共享 + 自动挂载，不带任何额外界面特效）
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y

# ========== 网络工具（轻量，不影响内存） ==========
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y

# ========== 强制关闭所有“内存杀手” ==========
# 下面这些全部不编译，防止手贱误开
# CONFIG_PACKAGE_luci-app-openlist2=n
# CONFIG_PACKAGE_luci-app-aria2=n
# CONFIG_PACKAGE_luci-app-passwall=n
# CONFIG_PACKAGE_luci-app-dockerman=n
# CONFIG_PACKAGE_luci-app-alist=n
# CONFIG_PACKAGE_luci-app-openclash=n
