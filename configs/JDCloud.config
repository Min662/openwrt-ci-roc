CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
# 【关键修改】：把原来双引号里的 led 插件彻底删掉，留空即可
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=""

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_luci-app-openlist2=y
# 【关键修改】：改成 is not set，或者干脆把这两行直接删掉
# CONFIG_PACKAGE_luci-app-athena-led is not set
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn is not set

# ========== 自定义驱动与插件（亚瑟专用-最初精简版） ==========
# 1. MT7612U 无线网卡驱动（唯一正确包名）
CONFIG_PACKAGE_kmod-mt76x2u=y
# 2. 手机 USB 共享（RNDIS协议）
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
# 3. 轻NAS必备（SMB文件共享 + 自动挂载）
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
# 4. 轻量下载器（Aria2，带界面，可选但占用小）
CONFIG_PACKAGE_luci-app-aria2=y
# 5. 必要的USB内核支持（让上面的驱动生效）
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
